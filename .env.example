# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/secure_vault

# Client & CORS — comma-separated list of allowed origins
# Local: http://localhost:5173
# Production: add your Vercel URL, e.g. https://file-sharing-vault.vercel.app
CORS_ORIGIN=http://localhost:5173,https://file-sharing-vault.vercel.app

# Rate Limiting (General API)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Authentication & Tokens
JWT_SECRET=replace_with_a_secure_random_string_min_32_chars_for_access_jwt
REFRESH_SECRET=replace_with_a_secure_random_string_min_32_chars_for_refresh_jwt

# Storage & Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_BYTES=52428800

